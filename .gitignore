# ============================================================
# Git ignore rules for Roboracer
# Track source code, configs, reports and project files.
# Ignore generated files, environments, caches and raw data.
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
f1env/
venv/
.venv/
env/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------
.vscode/
.idea/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Generated / temporary files
# ------------------------------------------------------------
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo

# ------------------------------------------------------------
# Large/raw/generated data
# ------------------------------------------------------------
# Raw experiment data
*.npz

# ------------------------------------------------------------
# Archives / exported documents
# ------------------------------------------------------------
*.zip

# ------------------------------------------------------------
# Python packaging / build output
# ------------------------------------------------------------
build/
dist/
*.egg-info/

# ------------------------------------------------------------
# Keep the actual project files
# ------------------------------------------------------------
# Source code:
#   scripts/
#   controllers/
#
# Configuration:
#   configs/
#
# Reports/documentation:
#   report/
#
# These directories are intentionally NOT ignored.
# ============================================================
# --- run output (added with the shared runner) ---------------------------------
# Logs and plots are regenerated from code; keep them out of the history so the repo
# does not fill with large binaries. Commit a figure only when it goes in the report.
results/*.csv
results/*.npz
results/*.log
*.npz
controllers/*/data/runs/*.csv
controllers/*/data/plots/*.png
!controllers/*/data/**/.gitkeep
__pycache__/
.venv
.venv/
